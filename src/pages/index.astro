---
import Base from '../layouts/Base.astro';
import EditionView from '../components/EditionView.astro';
import { editionPath, neighbors } from '../lib/dates';
import { getEditions } from '../lib/editions';
import { articleJsonLd, clipText } from '../lib/seo';

const editions = getEditions();
const edition = editions[0] ?? null;
const base = import.meta.env.BASE_URL;
const origin = Astro.site ?? new URL('https://crystiepaulette.github.io');
const canonical = edition ? new URL(editionPath(edition.date, base), origin).href : new URL(base, origin).href;
const title = edition ? `The Ecuador Brief — ${edition.datelineText}` : 'The Ecuador Brief';
const description = clipText(edition?.subtitle || 'Entender Ecuador, más allá de los titulares.');
const adjacent = edition ? neighbors(editions.map((item) => item.date), edition.date) : { prev: null, next: null };
const abs = (date: string | null) => (date ? new URL(editionPath(date, base), origin).href : null);
---

<Base
  editions={editions}
  current={edition?.date ?? null}
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={edition ? articleJsonLd(edition, canonical) : undefined}
  prevUrl={abs(adjacent.prev)}
  nextUrl={abs(adjacent.next)}
>
  {
    edition ? (
      <EditionView edition={edition} editions={editions} canonical={canonical} />
    ) : (
      <p class="empty">Todavía no hay ediciones. La próxima aparecerá al agregar un archivo en <code>editions/</code>.</p>
    )
  }
</Base>
