---
import Base from '../layouts/Base.astro';
import EditionView from '../components/EditionView.astro';
import { editionPath, neighbors } from '../lib/dates';
import { getEditions, type Edition } from '../lib/editions';
import { articleJsonLd, clipText } from '../lib/seo';

export function getStaticPaths() {
  return getEditions().map((edition) => ({
    params: { date: edition.date },
    props: { edition },
  }));
}

interface Props {
  edition: Edition;
}

const { edition } = Astro.props;
const editions = getEditions();
const base = import.meta.env.BASE_URL;
const origin = Astro.site ?? new URL('https://crystiepaulette.github.io');
const canonical = new URL(editionPath(edition.date, base), origin).href;
const title = `The Ecuador Brief — ${edition.datelineText}`;
const description = clipText(edition.subtitle || 'Entender Ecuador, más allá de los titulares.');
const adjacent = neighbors(editions.map((item) => item.date), edition.date);
const abs = (date: string | null) => (date ? new URL(editionPath(date, base), origin).href : null);
---

<Base
  editions={editions}
  current={edition.date}
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={articleJsonLd(edition, canonical)}
  prevUrl={abs(adjacent.prev)}
  nextUrl={abs(adjacent.next)}
>
  <EditionView edition={edition} editions={editions} canonical={canonical} />
</Base>
